# Copy to .env.local for local development. Never commit real values.

# --- Many clinics (production): Ariloo's registry, read-only ---------------
# ARILOO_DB_URL=libsql://ariloo-....turso.io
# ARILOO_DB_TOKEN=            # a READ-ONLY token for Ariloo's database
# SHOPS_DB_TOKEN=             # a Turso group token that opens every clinic's own database
# DOCTORS_SSO_SECRET=         # the same value as in Ariloo
# ARILOO_URL=https://ariloo.app

# --- Single clinic (local development without Ariloo) ----------------------
DB_TURSO_DATABASE_URL=file:local.db
DB_TURSO_AUTH_TOKEN=
OWNER_PASSWORD=change-me-please
SHOP_NAME=My Clinic
SHOP_CURRENCY=IQD
SHOP_DECIMALS=0
SHOP_LANG=en
